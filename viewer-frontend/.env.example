# OCR Viewer Frontend - Environment Variables
# Copy this file to .env.local and customize as needed

# Optional: Custom paths (defaults shown)
# OUTPUTS_DIR=../outputs
# PDFS_DIR=../pdfs
# PYTHON_PATH=/usr/bin/python3

# Optional: Server port (default is 3000)
# PORT=3000

# Optional: Enable detailed logging
# NEXT_PUBLIC_DEBUG=false
