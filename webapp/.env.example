# ══════════════════════════════════════════════════════
#  ScanToText — environment variables
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# ══════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────
# Leave blank to use SQLite (fine for local dev).
# Set to your Postgres URL for production (Railway/Render supply this automatically).
DATABASE_URL=

# ── Azure Document Intelligence ───────────────────────
AZURE_DI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DI_API_KEY=your-azure-key

# ── Stripe ────────────────────────────────────────────
# DEV:  sk_test_... / pk_test_...
# PROD: sk_live_... / pk_live_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Get from Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# The Price ID for your monthly Pro plan
STRIPE_PRICE_ID=price_...

# ── AI APIs ───────────────────────────────────────────
GEMINI_API_KEY=your-gemini-key
MISTRAL_API_KEY=your-mistral-key

# ── App settings ──────────────────────────────────────
# Change to your real production domain (must match Google OAuth redirect URIs)
BASE_URL=http://localhost:8000
# Comma-separated list of allowed CORS origins. Defaults to BASE_URL if unset.
# Example for production: https://scantotext.com,https://www.scantotext.com
CORS_ORIGINS=

MAX_FILE_SIZE_MB=50
# Delete job upload directories older than this many hours (default 24)
UPLOAD_MAX_AGE_HOURS=24

PLAN_PRICE_DISPLAY=£20/mo
MONTHLY_PAGE_LIMIT=2000
TRIAL_DAYS=7
TRIAL_PAGE_LIMIT=1000

# ── Auth ──────────────────────────────────────────────
# REQUIRED for production — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_generate_a_strong_random_value

# ── Google OAuth ──────────────────────────────────────
# Create credentials at console.cloud.google.com → APIs & Services → Credentials
# Add authorised redirect URI: {BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret

# ── Demo / dev mode ───────────────────────────────────
# Set to 1 to skip Stripe entirely (auto-approve all subscriptions).
# Must be 0 in production.
DEMO_MODE=1

# ── Admin dashboard ────────────────────────────────────
# Secret password for the /admin dashboard (completely separate from user OAuth).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_PASSWORD=change_me_strong_admin_password
